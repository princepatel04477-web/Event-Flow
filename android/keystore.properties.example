# Copy to android/keystore.properties and fill in real values. The real file
# is gitignored — never commit it. See M10 in mobile-conversion-prompts.md.
#
# WARNING: losing this keystore means every staff member must uninstall and
# reinstall, losing queued offline data. Back it up to two places TODAY.
#
# Generate the keystore (run on a machine with a JDK):
#   keytool -genkeypair -v -keystore eventops-release.jks \
#     -alias eventops -keyalg RSA -keysize 2048 -validity 10000 \
#     -storetype JKS
#
# Store eventops-release.jks OUTSIDE this repo (e.g. a private drive + a
# second backup), then point storeFile at it.

storeFile=/absolute/path/to/eventops-release.jks
storePassword=CHANGE_ME
keyAlias=eventops
keyPassword=CHANGE_ME
