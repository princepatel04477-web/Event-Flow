# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.test.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Excel guest-list data — real phone numbers. Never enters git.
*.xlsx
*.xls

# Local tooling / IDE / AI-assistant state — never shared.
/.idea/
/.commandcode/
/.claude/
/.testsprite/
/testsprite_tests/tmp/

# Obsidian vault UI state (churns on every pane change)
eventflow/.obsidian/workspace.json

# Android signing (M10) — keystore and credentials never enter the repo.
*.jks
*.keystore
android/keystore.properties
android/app/release/
android/app/build/
android/build/
android/.gradle/
android/local.properties

testsprite_tests\tmp\config.json

# ---------------------------------------------------------------------
# Real guest data. `backups/` holds full database dumps produced by
# scripts/backup-data.mjs — 558 phone numbers and 710 names in the one
# that existed when this line was added. Same rule as *.xlsx above:
# personal data never enters git.
# ---------------------------------------------------------------------
/backups/

# Test and tooling output
/test-results/
/playwright-report/
/.playwright-mcp/
/e2e/perf-*.md
/e2e/routes-*.json

# Scratch files and captured console/error dumps from debugging sessions
/all-console-errors.txt
/playwright-err.txt
/scratchpad_err.txt
/scratch_preview_orig.tsx
/scratchpad_foundation_head.sql
/*.zip

# Screenshots captured while debugging screens (regenerate as needed)
/arrivals.png
/board.png
/deliveries.png
/deliveries2.png
/fleet.png
/queue.png
/rooms.png

# Cloudflare / OpenNext build output
.open-next/
.wrangler/

# Release signing — the keystore and its passwords live OUTSIDE the repo.
# Losing the keystore means every phone must uninstall and reinstall.
*.jks
*.keystore
android/keystore.properties
