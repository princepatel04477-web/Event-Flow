# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Excel guest-list data — real phone numbers. Never enters git.
*.xlsx
*.xls

# Local tooling / IDE / AI-assistant state — never shared.
/.idea/
/.commandcode/
/.claude/
/.testsprite/
/testsprite_tests/tmp/

# Obsidian vault UI state (churns on every pane change)
eventflow/.obsidian/workspace.json

# Android signing (M10) — keystore and credentials never enter the repo.
*.jks
*.keystore
android/keystore.properties
android/app/release/
android/app/build/
android/build/
android/.gradle/
android/local.properties

testsprite_tests\tmp\config.json
