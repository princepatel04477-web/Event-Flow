# Acceptance-test environment. Copy to .env.test and fill in real values.
# .env.test is gitignored. The service role key is TEST-ONLY — it is used
# only by e2e/helpers/db.ts to verify database state directly, and must
# never be imported by application code.

# The running dev server (default http://localhost:3000)
E2E_BASE_URL=http://localhost:3000

# Admin account (email/password on /admin/login)
E2E_USER_A_EMAIL=admin@example.com
E2E_USER_A_PASSWORD=replace-me

# A second admin/team account (email/password on /admin/login)
E2E_USER_B_EMAIL=staff@example.com
E2E_USER_B_PASSWORD=replace-me

# Code-auth codes for the test event (see scripts/seed-test-auth.mjs to create)
# Team code (E-XXXXXX) — logs in on /login, then picks E2E_TEAM_STAFF
E2E_TEAM_CODE=E-XXXXXX
# Client code (C-XXXXXX) — logs in on /login, read-only
E2E_CLIENT_CODE=C-XXXXXX
# The staff member the team login selects in the "Who are you?" step
E2E_TEAM_STAFF=Test Caller A

# Supabase project (service role key verifies DB state in tests)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=paste-your-service-role-key-here

# The event the acceptance run targets
E2E_EVENT_ID=00000000-0000-0000-0000-000000000000
