{
  "name": "app-scaffold",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "test:fixture": "node scripts/build-test-fixture.mts",
    "eval:extraction": "vitest run tests/extraction-eval.test.ts",
    "test:acceptance": "node e2e/fixtures/generate.mjs && node scripts/seed-543.mjs && npx playwright test --project=phone && node e2e/report.mjs",
    "types:gen": "npx supabase gen types typescript --linked --schema public,app > src/lib/supabase/database.types.ts",
    "mobile": "next build && npx cap sync android",
    "mobile:dev": "node scripts/mobile-dev.mjs",
    "mobile:launch": "adb shell am start -n com.nuvent.app/.MainActivity",
    "mobile:local": "next build && npx cap sync android",
    "mobile:prod": "npx cap sync android",
    "smoke": "node scripts/smoke.mjs",
    "test:t1": "vitest run tests/t1_isolation.test.ts"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/app": "^8.1.1",
    "@capacitor/app-launcher": "^8.0.1",
    "@capacitor/camera": "^8.2.2",
    "@capacitor/cli": "^8.5.0",
    "@capacitor/core": "^8.5.0",
    "@capacitor/device": "^8.0.3",
    "@capacitor/filesystem": "^8.1.2",
    "@capacitor/network": "^8.0.1",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.3",
    "@sentry/capacitor": "4.2.0",
    "@sentry/react": "10.60.0",
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.111.0",
    "capacitor-voice-recorder": "^7.0.6",
    "date-fns": "^4.4.0",
    "dexie": "^4.4.4",
    "idb": "^8.0.3",
    "jose": "^6.2.8",
    "motion": "13.1.0",
    "next": "16.2.12",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "server-only": "^0.0.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.2",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^20.19.43",
    "@types/react": "19.2.18",
    "@types/react-dom": "^19.2.4",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.2.12",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10",
    "wrangler": "^4.120.0"
  }
}
